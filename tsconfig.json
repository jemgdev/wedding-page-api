{
  "compilerOptions": {
    "isolatedModules": true,
    "types": ["jest", "node"],
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "removeComments": true,
    "module": "commonjs",
    "declaration": true,
    "strict": true,
    "target": "ES2022",
    "sourceMap": true,
    "baseUrl": "./src",
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      // comment
      "@comment/*": ["comment/*"],
      "@comment/domain/*": ["comment/domain/*"],
      "@comment/value-objects/*": ["comment/domain/value-objects/*"],
      "@comment/application/*": ["comment/application/*"],
      "@comment/usecases/*": ["comment/application/usecases/*"],
      "@comment/ports/*": ["comment/application/ports/*"],
      "@comment/infrastructure/*": ["comment/infrastructure/*"],
      "@comment/driven/*": ["comment/infrastructure/driven/*"],
      "@comment/driving/*": ["comment/infrastructure/driving/*"],

      // shared
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "**/*.test.ts"]
}
